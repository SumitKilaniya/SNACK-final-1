# ─────────────────────────────────────────────────────────────────────────────
# Snack-Pod Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# --- Core Application & Database ---
# Base application URL (used for CORS, cookies, and OAuth redirects)
APP_ORIGIN=http://localhost:3000
# Public site URL used in metadata and link generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgresql://snackpod:snackpod@localhost:5432/snackpod

# --- Authentication & Security Secrets ---
# 32+ character secret for signing short-lived JWT access tokens
JWT_ACCESS_SECRET=local-only-access-secret-change-before-production-0123456789
# 32+ character secret for signing password reset tokens
JWT_RESET_SECRET=local-only-reset-secret-change-before-production-0123456789
# --- Google OAuth (Optional) ---
# Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=

# --- Payments (Stripe) ---
# Stripe Secret Key for server-side order and checkout sessions
STRIPE_SECRET_KEY=
# Stripe Webhook Secret for validating incoming checkout events
STRIPE_WEBHOOK_SECRET=
# Stripe Publishable Key for client-side Stripe Elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- SMS & OTP (Twilio - required for production signup) ---
# Twilio credentials for sending phone verification OTP SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM=
SMS_PROVIDER=

# --- Email delivery (required for production password reset/order email) ---
EMAIL_PROVIDER=
RESEND_FROM=

# --- Bot Protection (Google reCAPTCHA v3 - Optional) ---
# reCAPTCHA Secret Key for backend validation
RECAPTCHA_SECRET=
# reCAPTCHA Site Key for frontend form verification
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Observability & Infrastructure (Optional) ---
# Sentry DSN for exception tracking and performance monitoring
SENTRY_DSN=
# Redis connection URL for distributed rate limiting (falls back to in-memory)
REDIS_URL=
# Resend API Key for sending transactional emails (order receipts, password resets)
RESEND_API_KEY=
