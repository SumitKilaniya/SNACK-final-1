# Node modules
node_modules/
package-lock.json

# Next.js build output
.next/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Optional: if using TurboRepo or monorepo
turbo/
# Freebuff app artifacts
.freebuff/*.db
.freebuff/*.db-shm
.freebuff/*.db-wal
.freebuff/*.log
.freebuff/preview.pid

# Environment secrets — never commit (any *.env file; .env.example stays tracked)
*.env
.env
.env.local
.env.*.local
.env.production
.env.test

# Local database files (migrations in prisma/migrations are committed)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
