
{
  "name": "qsrorder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "db:migrate:deploy": "prisma migrate deploy",
    "admin:create:super-admin": "node scripts/create-super-admin.js",
    "postinstall": "prisma generate",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "images:fetch": "node scripts/fetch_dish_images.mjs",
    "serve": "next start -H 0.0.0.0",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@dhiwise/component-tagger": "^1.0.16",
    "@heroicons/react": "^2.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^10.69.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.7.0",
    "next": "15.5.26",
    "prisma": "6.19.3",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "recharts": "^2.15.2",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.4.49"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
