        "@types/node": "^20",
        "@types/react": "19.0.3",
        "@types/react-dom": "19.0.3",
        "@typescript-eslint/eslint-plugin": "^8.29.0",
        "@typescript-eslint/parser": "^8.29.0",
        "autoprefixer": "10.4.2",
        "eslint": "^9",
        "eslint-config-next": "^15.2.4",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.6",
        "postcss": "^8.4.49",
        "prettier": "^3.5.3",
        "prisma": "^6.19.3",
        "tailwindcss": "3.4.6",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5",
